# --- Roostoo API credentials (from the hackathon organizers) ---
ROOSTOO_API_KEY=your_api_key_here
ROOSTOO_API_SECRET=your_api_secret_here

# --- Run mode ---
DRY_RUN=false                 # true = paper trade with real prices, no orders sent
POLL_SECONDS=60               # how often the bot wakes up (keep >= 30 to avoid rate limits)
PAIRS=BTC/USD,ETH/USD,BNB/USD,SOL/USD,XRP/USD

# --- Strategy: mean reversion ---
WINDOW=60                     # rolling window, in samples (60 x 60s = 1 hour)
ENTRY_Z=1.5                   # buy when z-score <= -ENTRY_Z
EXIT_Z=0.0                    # sell when z-score >= EXIT_Z
MIN_EDGE_PCT=0.003            # distance to mean must beat fees (0.3%)

# --- Risk management ---
MAX_POSITION_PCT=0.10         # max 10% of equity per pair
MAX_EXPOSURE_PCT=0.50         # max 50% of equity invested at once
STOP_LOSS_PCT=0.03            # sell if price falls 3% below entry
MAX_HOLD_MINUTES=360          # sell if a trade hasn't reverted in 6 hours
MIN_SECONDS_BETWEEN_BUYS=10
MAX_ORDERS_PER_DAY=300

LOG_LEVEL=INFO
